# ── PhishGuard AI — Backend Environment Variables ────────────────────────────
# Copy this file to .env and edit the values for your environment.

# Application
APP_NAME=PhishGuard AI
APP_VERSION=1.0.0
DEBUG=true

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Path to the serialised Random Forest model file
# Uncomment and set this once the model is trained and saved with joblib
# MODEL_PATH=model/phishing_model.pkl

# Maximum URL length accepted by the API
MAX_URL_LENGTH=2048
