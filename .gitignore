# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables — NEVER commit real .env files
.env
!.env.example

# ML model artifacts (potentially large — commit separately or use Git LFS)
backend/model/*.pkl
backend/model/*.joblib
backend/model/*.h5
backend/model/*.pt

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.production

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing & coverage ────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
.cache/
